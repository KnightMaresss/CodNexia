# Database
MONGODB_URI=your_mongodb_connection_string
DB_NAME=your_database_name

# Authentication & Security
JWT_SECRET=your_jwt_secret
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=your_admin_email
CRON_SECRET=your_cron_secret

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=your_email_from_address

# Crypto Payments
NEXT_PUBLIC_CRYPTO_WALLET_ADDRESS=your_crypto_wallet_address
NEXT_PUBLIC_CRYPTO_NETWORK=TRC20
NEXT_PUBLIC_CRYPTO_COIN=USDT

# Crypto Verification & NowPayments
TRONGRID_API_KEY=your_trongrid_api_key
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_PAYOUT_ADDRESS=your_nowpayments_payout_address

# Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
